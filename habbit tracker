habits = {}

while True:
    print("\n1. Add Habit")
    print("2. Mark Completed")
    print("3. Show Progress")
    print("4. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        habit = input("Habit name: ")
        habits[habit] = 0

    elif choice == "2":
        habit = input("Habit completed: ")
        if habit in habits:
            habits[habit] += 1

    elif choice == "3":
        for habit, count in habits.items():
            print(f"{habit}: {count} days")

    elif choice == "4":
        break
