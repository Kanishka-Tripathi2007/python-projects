contacts = {}

while True:
    print("\n1. Add Contact")
    print("2. Search Contact")
    print("3. View All")
    print("4. Exit")

    choice = input("Choice: ")

    if choice == "1":
        name = input("Name: ")
        phone = input("Phone: ")
        contacts[name] = phone

    elif choice == "2":
        name = input("Enter name: ")
        print(contacts.get(name, "Not Found"))

    elif choice == "3":
        for name, phone in contacts.items():
            print(name, "-", phone)

    elif choice == "4":
        break
